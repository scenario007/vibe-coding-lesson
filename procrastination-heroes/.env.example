HTTP_PORT=8088
DB_HOST=127.0.0.1
DB_PORT=54329
DB_NAME=heroes
DB_USER=heroes
DB_PASSWORD=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_MODEL=deepseek-v4.1-flash
TOKENHUB_CONFIG_FILE=/absolute/path/to/teacher-config.json
# Alternative: set TOKENHUB_API_KEY in your server environment. Never use a VITE_ key.

# Optional server-side Aliyun Model Studio image generation. Never put this in VITE_ variables.
# Use a newly rotated key in .env.local; the key sent in chat must not be reused.
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_IMAGE_MODEL=wan2.7-image
ALIYUN_IMAGE_SIZE=1K
ALIYUN_IMAGE_GENERATION_ENABLED=true
# Leave false to keep the SVG fallback when the image service is unavailable.
ALIYUN_IMAGE_GENERATION_REQUIRED=false
# The backend downloads temporary result URLs here before returning a local URL to the frontend.
ALIYUN_IMAGE_ASSET_DIR=../frontend/public/generated

# Project-wide estimate + holds; persisted text usage and art manifest share the cap.
TOKENHUB_ROUND_BUDGET_CNY=10
# User declined paid images this round. Keep disabled unless explicitly authorized later.
TOKENHUB_IMAGE_GENERATION_ENABLED=false
